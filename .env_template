# This was inserted by `prisma init`:

# Environment variables declared in this file are automatically made available to Prisma.

# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.

# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# When prisma """" error: use external terminal without conda env! it messes up paths

DATABASE_URL="postgresql://USERNAME:PASSWORD@127.0.0.1:5432/DATABASENAME?schema=public"

# Please change the following values to suit your needs:

MODEL_WORKER_URL="http://127.0.0.1:8000"
RUN_NODE_TIMEOUT_MS="120000"

# Where the backend reaches the NLP worker in models/. Leave this unset and the
# backend falls back to a remote host that is not yours, so every learner answer
# a similarity, keyword or equivalence node touches leaves this machine. Docker
# Compose overrides it to http://models:8002; set it for `yarn dev`.
SIMILARITY_WORKER_URL="http://127.0.0.1:8002"

# Host ports for docker-compose.yml. Only the host side moves; the services
# always reach each other on the Compose network. Set the database one if you
# already run PostgreSQL locally, which is the usual clash. Changing the
# frontend port means changing FRONTEND_URL and CORS_ORIGIN to match.
# NODEGRADE_DATABASE_PORT="5432"
# NODEGRADE_MODELS_PORT="8002"
# NODEGRADE_BACKEND_PORT="5000"
# NODEGRADE_FRONTEND_PORT="8080"

# Passed through to the models service by docker-compose.yml. Defaults shown;
# both models are MIT, so the defaults need no licence decision. See
# README.md, "Choosing a different embedding model" before changing them.
# EMBEDDING_MODEL="BAAI/bge-m3"
# EMBEDDING_MAX_SEQ_LENGTH="512"
# Only for task-conditioned models, e.g. text-matching on jina-v3.
# EMBEDDING_TASK=""
# Executes Python from the model repository inside the worker. Leave false
# unless the chosen model requires it and you trust that repository.
# EMBEDDING_TRUST_REMOTE_CODE="false"
# Empty disables /entailment; text/semantic-equivalence then falls back to its
# cosine ceiling and reports nli-unavailable instead of failing.
# NLI_MODEL="MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7"
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
KATALYST_API_KEY=""
# Base64url-encoded 32-byte key. Keep this value stable across backend restarts.
PROVIDER_ENCRYPTION_KEY=""

# Facilitator sign-in at /admin. The admin area stays disabled unless both are set.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

FRONTEND_URL="http://localhost:5173"

XAPI_ENDPOINT="https://xapi.xapi.com"
XAPI_USERNAME="username"
XAPI_PASSWORD="password"

# when using a custom OpenAPI compatible endpoint and auth is needed

BEARER_TOKEN=""
