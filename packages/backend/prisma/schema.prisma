// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// graph contains blob of graph data
//
// Superseded by Workspace/Workflow (SPEC-0004). Kept until the rows have been backfilled
// and the new model has proven itself on real data; renamed to LegacyGraph and dropped in
// a later migration.
model LegacyGraph {
  id    Int    @id @default(autoincrement())
  path  String @unique
  graph String
}

// ---------------------------------------------------------------------------
// Workspaces and workflows (SPEC-0004)
// ---------------------------------------------------------------------------

enum WorkspaceType {
  BROWSER
  WORKSHOP
  LTI
}

/// A workspace owns workflows and is the unit every operation is scoped to.
///
/// Authorization derives from the access token, never from the id: the id appears in
/// URLs and is not a credential (FR-004). Only the token's SHA-256 hash is stored, so a
/// database dump cannot be replayed as a participant.
model Workspace {
  id        String        @id @default(cuid(2))
  type      WorkspaceType
  label     String?
  /// sha256 hex of the opaque access token. Null means the workspace cannot be reached
  /// by token at all, which is how the legacy migration target stays admin-only.
  tokenHash String?       @unique
  /// "<issuer>|<context_id>|<resource_link_id>" for LTI workspaces (FR-008).
  ltiKey    String?       @unique

  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  /// Drives retention (FR-009..FR-011). Written at most once per workspace per 5
  /// minutes rather than on every request.
  lastActiveAt DateTime @default(now())

  workflows Workflow[]
  runs      Run[]

  @@index([type, lastActiveAt])
  @@index([workshopId])
}

/// A user-owned workflow. Identity is (workspace, slug); the editor URL is not part of
/// it (SPEC-0001 cross-feature rule).
model Workflow {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  slug String
  name String
  /// Serialized LiteGraph JSON. Stored as text rather than jsonb so the backfill from
  /// Graph.graph is a literal column copy and no key reordering can occur.
  content String
  /// Optimistic concurrency counter (FR-012, FR-013). Carried as an ETag.
  version Int    @default(1)
  /// Stamp used by the in-process content migration to find unconverted rows.
  contentSchema Int @default(2)

  /// The instructor edits `content`; students read `publishedContent`. Replaces the old
  /// editor/student path pair, which was the only draft/publish gate LTI had.
  publishedContent String?
  publishedVersion Int?
  publishedAt      DateTime?

  sourceTemplateId         String?
  sourceTemplate           Template?         @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  sourceTemplateRevisionId String?
  /// Restrict, not SetNull: a revision a workflow can still be reset to must not be
  /// deletable (SPEC-0003/FR-003b).
  sourceTemplateRevision   TemplateRevision? @relation(fields: [sourceTemplateRevisionId], references: [id], onDelete: Restrict)

  /// The pre-migration Graph.path. Provenance, and the key LTI first-launch adoption
  /// looks the workflow up by. Dropped once the legacy table goes.
  legacyPath String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs     Run[]
  versions WorkflowVersion[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([sourceTemplateRevisionId])
  @@index([contentSchema])
}

/// A past state of a workflow, kept so an edit can be undone after the editor is closed
/// (SPEC-0021).
///
/// Written *before* the state it records is overwritten, so the row always holds content
/// that is no longer current: the live row is the present, these are the past. The
/// version number is the workflow's optimistic counter at the moment of capture, which
/// is what the history list shows.
model WorkflowVersion {
  id         String   @id @default(cuid(2))
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /// `Workflow.version` the snapshot was taken at. Not unique: a restore captures the
  /// live state again, and repeated saves at the same version cannot happen but a
  /// restored-then-re-restored workflow can revisit one.
  version Int
  name    String
  content String
  /// Carried, not stamped: restoring must not claim content was migrated when it was
  /// captured before a content-schema change.
  contentSchema Int @default(2)
  /// Why the state was captured: `save`, `reset` or `restore`. A code rather than a
  /// sentence, so the wording of the history list stays in the frontend.
  reason String @default("save")
  /// Nodes in the captured graph, so the list can be read without loading content.
  nodeCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([workflowId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Run records (SPEC-0020)
// ---------------------------------------------------------------------------

enum RunOutcome {
  COMPLETED
  FAILED
}

/// One completed or failed execution, written by the socket run handler before the
/// terminal event and read over REST (ADR-0009). The trace stays ephemeral (SPEC-0006);
/// only the answer, the emitted outputs and the derived review flag are kept.
model Run {
  /// The run id the socket events carried, so a client can match what it saw.
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  outcome RunOutcome
  /// Capped in the service; the graph already cuts answers at 1500 characters.
  answer  String
  /// Sanitized `outputSet` payloads in execution order, capped per value and per run.
  outputs Json
  /// First `score` output, denormalized so the list never loads `outputs`.
  score   Float?

  /// Any `review` output with verdict `flagged` (FR-005); the reasons joined.
  flagged      Boolean @default(false)
  flagReason   String?
  errorMessage String?
  /// LTI launch display name; null for browser and workshop workspaces (FR-007).
  submittedBy  String?

  reviewedAt DateTime?
  reviewNote String?

  startedAt  DateTime
  finishedAt DateTime
  durationMs Int

  @@index([workflowId, startedAt(sort: Desc)])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Templates (SPEC-0003)
// ---------------------------------------------------------------------------

enum TemplateKind {
  WORKFLOW
  BLOCK
}

enum RevisionOrigin {
  BUNDLED
  FACILITATOR
}

model Template {
  id   String       @id @default(cuid(2))
  slug String       @unique
  kind TemplateKind

  name        String
  description String?
  category    String?
  tags        String[] @default([])

  published Boolean @default(false)
  /// The latest revision NUMBER, not a foreign key. Incrementing it inside the same
  /// transaction that inserts the revision keeps "create revision N+1" race-free
  /// without a circular relation or a locking read.
  currentRevision Int @default(0)

  /// Soft delete. FR-003c requires revisions to stay resolvable after the template is
  /// removed from the gallery.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions       TemplateRevision[]
  workflows       Workflow[]
  workshops       Workshop[]
  workshopEntries WorkshopTemplate[]

  @@index([kind, published, deletedAt])
}

/// Immutable snapshot of a template (FR-003, FR-003a). Never updated in place.
model TemplateRevision {
  id         String   @id @default(cuid(2))
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  revision Int
  origin   RevisionOrigin @default(FACILITATOR)

  name        String
  description String?
  category    String?
  tags        String[] @default([])

  content String
  /// sha256 hex of content. Lets the bundled-template seeder recognise unchanged
  /// content and stay idempotent across restarts.
  contentHash   String
  contentSchema Int    @default(2)

  /// Declared external input/output ports for block templates (FR-019).
  interfaces Json?

  createdAt DateTime @default(now())

  workflows       Workflow[]
  workshops       Workshop[]
  workshopEntries WorkshopTemplate[]

  @@unique([templateId, revision])
  @@index([templateId, revision(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Workshops (SPEC-0014)
// ---------------------------------------------------------------------------

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Workshop {
  id String @id @default(cuid(2))
  /// Stored normalized (uppercase, separators stripped) so lookup cannot disagree with
  /// what was written.
  code  String @unique
  title String

  status WorkshopStatus @default(DRAFT)

  /// Legacy single-template reference (SPEC-0014), superseded by `templates`
  /// (SPEC-0022). Backfilled into WorkshopTemplate, no longer read or written, and
  /// dropped by a later migration.
  templateId         String?
  template           Template?         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateRevisionId String?
  templateRevision   TemplateRevision? @relation(fields: [templateRevisionId], references: [id], onDelete: Restrict)

  /// The workflow templates participants may start, in display order (SPEC-0022/FR-001).
  templates WorkshopTemplate[]

  expiresAt   DateTime?
  publishedAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@index([status, expiresAt])
}

/// One workflow template a workshop offers (SPEC-0022/FR-001). A null revision follows
/// the template's current revision, resolved when a participant starts the entry; a set
/// revision pins it and survives unpublishing (FR-002).
model WorkshopTemplate {
  id         String   @id @default(cuid(2))
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  templateId         String
  template           Template          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateRevisionId String?
  templateRevision   TemplateRevision? @relation(fields: [templateRevisionId], references: [id], onDelete: Restrict)

  position  Int
  createdAt DateTime @default(now())

  @@unique([workshopId, templateId])
  @@index([workshopId, position])
  @@index([templateId])
  @@index([templateRevisionId])
}

// ---------------------------------------------------------------------------
// Facilitator sessions (SPEC-0013)
// ---------------------------------------------------------------------------

/// Persisted rather than in-process: `nest start --watch` restarts on every file save,
/// which would log the facilitator out mid-task while preparing a workshop.
model AdminSession {
  id String @id @default(cuid(2))
  /// sha256 hex of the session cookie value.
  tokenHash String @unique
  /// sha256 hex of the CSRF token, binding it to this session rather than relying on
  /// cookie/header equality alone.
  csrfHash String

  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// LLM providers (SPEC-0010..0012) — data model only in this wave
// ---------------------------------------------------------------------------

enum ProviderType {
  MODEL_WORKER
  OPENAI
  OPENROUTER
  OPENAI_COMPATIBLE
}

enum ModelPolicyMode {
  DENY_ALL
  ALLOWLIST
  ALLOW_ALL
}

model Provider {
  id String @id @default(cuid(2))
  /// Stable reference serialized into workflow content as ModelRef.providerKey. Must be
  /// identical across deployments or migrated workflows will not resolve.
  key         String       @unique
  type        ProviderType
  displayName String

  baseUrl String?
  /// "v1.<b64 iv>.<b64 tag>.<b64 ciphertext>", AES-256-GCM. Never returned by the API.
  apiKeyEnc String?
  /// Masked hint proving a key is configured without revealing it (SPEC-0011/FR-004).
  apiKeyHint String?

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modelPolicy ModelPolicy?
}

model ModelPolicy {
  id         String   @id @default(cuid(2))
  providerId String   @unique
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Null means the facilitator has not chosen a mode yet. A cloud provider cannot be
  /// enabled while it is null, so no enabled provider ever falls back to an implicit
  /// allow (SPEC-0012/FR-002).
  mode          ModelPolicyMode?
  allowedModels String[]         @default([])

  updatedAt DateTime @updatedAt
}

/// Deployment-global concurrency guards protecting a shared provider key
/// (SPEC-0012/FR-010..FR-012). Exactly one row, keyed by SINGLETON_ID.
model ExecutionLimits {
  id                         String   @id
  workspaceConcurrentRuns    Int
  providerConcurrentRequests Int
  updatedAt                  DateTime @updatedAt
}

/// Deployment-global defaults owned by the facilitator (SPEC-0016). Exactly one row,
/// keyed by SINGLETON_ID. When set, every model node without an explicit `model_ref`
/// executes against the default instead of failing with "select a model".
model DeploymentSettings {
  id String @id

  /// Provider-qualified default model (ModelRef.providerKey). Null means no default:
  /// every model node needs its own selection.
  defaultProviderKey String?
  defaultModelId     String?

  updatedAt DateTime @updatedAt
}

// LTI Platform Registration
model LtiPlatform {
  id                               Int                    @id @default(autoincrement())
  clientId                         String                 @unique
  clientRegistration               LtiClientRegistration? // one to one
  // from openid configuration:
  issuer                           String
  jwksUri                          String
  authorizationEndpoint            String
  registrationEndpoint             String
  scopesSupported                  String[] // "https://purl.imsglobal.org/spec/lti-ags/scope/score",
  responseTypesSupported           String[] // i.e. "code","id_token","token id_token"
  subjectTypesSupported            String[] // i.e. "public","pairwise"
  idTokenSigningAlgValuesSupported String[] // i.e. "RS256"
  claimsSupported                  String[] // i.e. "sub","name","given_name","family_name","middle_name","nickname","preferred_username","profile","picture","website","email","email_verified
  productFamilyCode                String // "moodle",
  version                          String // "4.0.4+ (Build: 20221104)",
  variables                        String[] // i.e."basic-lti-launch-request","Context.id","Context.title","Context.label",
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
}

model LtiClientRegistration {
  id                      Int         @id @default(autoincrement())
  clientId                String      @unique
  responseTypes           String[]
  jwksUri                 String
  initiateLoginUri        String
  grantTypes              String[]
  redirectUris            String[]
  applicationType         String
  tokenEndpointAuthMethod String
  clientName              String
  logoUri                 String?
  scope                   String
  ltiToolConfiguration    Json
  LtiPlatform             LtiPlatform @relation(fields: [ltiPlatformId], references: [id])
  ltiPlatformId           Int         @unique
}
