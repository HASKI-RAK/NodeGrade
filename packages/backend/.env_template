XAPI_ENDPOINT="https://localhost/xapi"
DATABASE_URL="postgresql://username:password@127.0.0.1:5433/DBNAME?schema=public"
XAPI_USERNAME=""
XAPI_PASSWORD=""
MODEL_WORKER_URL="http://localhost:8000"
SIMILARITY_WORKER_URL="http://localhost:8002"
FRONTEND_URL="https://localhost:5173"
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
# Base64url-encoded 32-byte key. Keep this value stable across backend restarts.
PROVIDER_ENCRYPTION_KEY=""
PORT=5000
WS_PORT=5000
# Comma-separated list of allowed CORS origins
CORS_ORIGIN="https://nodegrade.haski.app,http://localhost:5173"
# when using a custom OpenAPI compatible endpoint and auth is needed
BEARER_TOKEN=""

# Facilitator (admin) login. Administrative features stay disabled unless both are set.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Session lifetime in hours. Defaults to 8.
ADMIN_SESSION_TTL_HOURS=8
# Issue cookies without the Secure attribute. Needed when serving plain HTTP on
# localhost; must stay false anywhere a browser can reach over the network.
COOKIE_INSECURE=false

# Delete ended workshop workspaces (and any legacy browser workspaces) after 60 days
# of inactivity (SPEC-0004). Set to false to keep everything.
RETENTION_ENABLED=true
# How many workflows one participant workspace may hold. LTI workspaces are exempt.
WORKSPACE_MAX_WORKFLOWS=50
# Version history (SPEC-0021): how many past states are kept per workflow, and how long
# one of them stands for the autosaves that follow it.
WORKFLOW_HISTORY_LIMIT=20
WORKFLOW_HISTORY_INTERVAL_MS=120000
# How many workspaces one address may create by joining workshops per window. Re-joins
# are not counted. A workshop room shares one address, so this has to tolerate everyone
# arriving at once.
WORKSPACE_CREATE_MAX=100
WORKSPACE_CREATE_WINDOW_MS=3600000

# Install the bundled templates on startup (SPEC-0003). Only ever appends; it leaves a
# template alone once a facilitator has edited it.
TEMPLATE_SEED_ENABLED=true

# LTI (docs/lti.md). LTI_PLATFORMS is a JSON array of the LTI 1.3 platforms allowed to
# launch NodeGrade; empty means none. LTI_TOOL_PRIVATE_KEY is an optional PEM RSA key
# whose public half GET /lti/jwks serves. LTI_TOOL_URL overrides the public base URL of
# the /lti routes when the request origin is not it. LTI_CONSUMER_KEY and
# LTI_CONSUMER_SECRET verify the deprecated LTI 1.1 basic launch; unset disables that
# check for local testing only.
LTI_PLATFORMS=""
LTI_TOOL_PRIVATE_KEY=""
LTI_TOOL_URL=""
LTI_CONSUMER_KEY=""
LTI_CONSUMER_SECRET=""
