# Configuration for the NLP worker (model_worker.py), read by python-dotenv when
# the worker runs outside Docker. In Compose these come from docker-compose.yml
# instead, and this file is not used.
#
# Copy to models/.env and adjust. Every value here is a default the worker
# already applies, so an empty .env behaves identically.

# Which embedding model /sentence_embedding and /similarity load. Multilingual,
# MIT licensed, 1024 dimensions. No weights ship in this repository - the worker
# downloads this from Hugging Face on first boot (2.3 GB), so the licence that
# applies to your deployment is the licence of whatever you name here.
# See README.md, "Choosing a different embedding model".
EMBEDDING_MODEL="BAAI/bge-m3"

# Token cap per input. bge-m3 advertises 8192; short-answer grading never needs
# that, and the cap bounds worst-case latency on CPU.
EMBEDDING_MAX_SEQ_LENGTH="512"

# Task name for task-conditioned models (jina-v3, the e5 instruct family).
# Empty for models that take no task, which is most of them. The worker refuses
# to start if the task it was given has no effect on the model it loaded.
EMBEDDING_TASK=""

# Lets transformers download and execute Python from the model repository inside
# this process. Required by jina-v3, which also pulls code from a second
# repository. Off unless the chosen model needs it and you trust that source.
EMBEDDING_TRUST_REMOTE_CODE="false"

# Entailment cross-encoder behind /entailment, loaded on first request rather
# than at boot. Set empty to run without it: /entailment then answers 503 and
# text/semantic-equivalence falls back to its cosine ceiling, reporting
# nli-unavailable rather than failing the run.
NLI_MODEL="MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7"

# Where model weights are cached. Defaults to /models-cache, which is the volume
# the Docker image mounts; outside Docker point it at a directory that exists.
# HF_HOME="./.model-cache"

# Port the worker listens on. The backend's SIMILARITY_WORKER_URL must match.
PORT="8002"
